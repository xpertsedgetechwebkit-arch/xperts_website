# COPY TO backend/.env FOR LOCAL DEVELOPMENT. NEVER COMMIT .env OR SHARE IT.
NODE_ENV=development
PORT=3001
# From Supabase Dashboard > Connect > Session pooler (IPv4, port 5432).
# Use restricted xpertsedge_leads_writer role created by database/01_writer_role.sql.
# URL-ENCODE RESERVED CHARACTERS in the password: @ : / ? # & % etc.
DATABASE_URL=postgresql://xpertsedge_leads_writer.YOUR_PROJECT_REF:URL_ENCODED_PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://xpertsedgetech.com,https://www.xpertsedgetech.com
RATE_LIMIT_MAX=30
